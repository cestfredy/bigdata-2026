<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Configuration HDFS du client jupyter. Doit rester cohérente avec hadoop.env :
  la taille de bloc et le facteur de réplication sont fixés par le CLIENT au
  moment de l'écriture, pas par le NameNode. Une divergence ici produirait des
  fichiers découpés autrement que ce que le cours annonce.
-->
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <property>
    <name>dfs.blocksize</name>
    <value>33554432</value>
  </property>
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
