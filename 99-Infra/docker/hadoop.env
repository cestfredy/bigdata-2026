# ============================================================================
#  Configuration Hadoop 3.3.6 — injectée dans les fichiers XML par l'image
#  officielle apache/hadoop. La convention est :
#      <FICHIER>.XML_<nom.de.la.propriete>=<valeur>
#  Ce fichier remplace l'édition manuelle de core-site.xml, hdfs-site.xml,
#  yarn-site.xml et mapred-site.xml.
# ============================================================================

# ---------------------------------------------------------------- core-site
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.http.staticuser.user=root
CORE-SITE.XML_hadoop.tmp.dir=/opt/hadoop/tmp
# Accès au stockage objet MinIO (module 2)
CORE-SITE.XML_fs.s3a.endpoint=http://minio:9000
CORE-SITE.XML_fs.s3a.access.key=minioadmin
CORE-SITE.XML_fs.s3a.secret.key=minioadmin
CORE-SITE.XML_fs.s3a.path.style.access=true
CORE-SITE.XML_fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem
CORE-SITE.XML_fs.s3a.connection.ssl.enabled=false

# ---------------------------------------------------------------- hdfs-site
HDFS-SITE.XML_dfs.namenode.name.dir=/opt/hadoop/data/nameNode
HDFS-SITE.XML_dfs.datanode.data.dir=/opt/hadoop/data/dataNode
# Réplication à 2 : nous n'avons que 2 DataNodes dans la maquette.
# En production le défaut est 3 (voir cours S3, placement des réplicas).
HDFS-SITE.XML_dfs.replication=2
# Taille de bloc volontairement réduite à 32 Mio pour que les jeux de données
# pédagogiques (quelques centaines de Mio) produisent plusieurs blocs
# observables. Le défaut de production est 128 Mio.
HDFS-SITE.XML_dfs.blocksize=33554432
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# Les clients joignent les DataNodes par leur nom d'hote, pas par leur IP interne :
# indispensable en conteneurs.
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true

# ---------------------------------------------------------------- yarn-site
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle
YARN-SITE.XML_yarn.nodemanager.resource.memory-mb=4096
YARN-SITE.XML_yarn.nodemanager.resource.cpu-vcores=4
YARN-SITE.XML_yarn.scheduler.maximum-allocation-mb=4096
YARN-SITE.XML_yarn.scheduler.minimum-allocation-mb=512
# Désactivé : les conteneurs Spark de TP dépassent souvent la limite virtuelle
# et seraient tués sans raison pédagogique.
YARN-SITE.XML_yarn.nodemanager.vmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.pmem-check-enabled=false
YARN-SITE.XML_yarn.log-aggregation-enable=true
YARN-SITE.XML_yarn.nodemanager.env-whitelist=JAVA_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,CLASSPATH_PREPEND_DISTCACHE,HADOOP_YARN_HOME,HADOOP_MAPRED_HOME

# -------------------------------------------------------------- mapred-site
MAPRED-SITE.XML_mapreduce.framework.name=yarn
MAPRED-SITE.XML_yarn.app.mapreduce.am.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.map.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.reduce.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.map.memory.mb=1024
MAPRED-SITE.XML_mapreduce.reduce.memory.mb=1024
